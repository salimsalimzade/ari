{
  "name": "ari",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "biome check .",
    "format": "biome check --write .",
    "generate:api": "pnpm --filter @ari/data-access generate:api",
    "docker": "docker compose --env-file apps/web/.env up --build"
  },
  "volta": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
